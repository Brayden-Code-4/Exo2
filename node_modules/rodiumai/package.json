{
  "name": "rodiumai",
  "version": "0.2.0",
  "description": "RodiumAI SDK — Unified AI API for Africa",
  "keywords": ["ai", "api", "africa", "llm", "openai-compatible"],
  "homepage": "https://rodiumai.io",
  "bugs": { "url": "https://github.com/jeanpierreaigbede/rodiumai-js-sdk/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/jeanpierreaigbede/rodiumai-js-sdk.git" },
  "license": "MIT",
  "author": "RodiumAI <dev@rodiumai.io>",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist/"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --check src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.0",
    "ts-jest": "^29.1.0",
    "nock": "^13.5.0",
    "@types/nock": "^11.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
